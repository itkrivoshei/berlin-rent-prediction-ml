entrypoint = "streamlit_app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "requirements.txt"]

[deployment]
run = ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8501
externalPort = 80
